# ============================================================================
#  TalentPulse — environment template
#
#  COPY THIS FILE TO `.env.local` AND FILL IN THE BLANKS.
#  `.env.local` is git-ignored; `.env.example` is not, so never put a real
#  secret in this file.
#
#      cp .env.example .env.local        (macOS / Linux / Git Bash)
#      copy .env.example .env.local      (Windows CMD)
#
#  Click-by-click instructions for every value below are in `what to do.md`
#  at the root of the project.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  1. ML BACKENDS  (unchanged — these are the three HuggingFace Spaces)
# ─────────────────────────────────────────────────────────────────────────────

# Module 3 — attrition prediction + SHAP + DiCE
VITE_API_URL=https://himadribiswas-talentpulse-backend.hf.space

# Module 1 — CV skill extraction (GLiNER)
VITE_MODULE1_API_URL=https://ijsasif-module-1-skill-extractor.hf.space

# Module 1 — resume ranking and debiasing
VITE_MODULE1_RANKING_API_URL=https://ijsasif-module-1-ranking-debiasing.hf.space

# Module 2 — skill gap analysis and learning path recommendation
VITE_MODULE2_API_URL=https://rafatkabir-talent-matching-api.hf.space


# ─────────────────────────────────────────────────────────────────────────────
#  2. MONGODB ATLAS  (required — see `what to do.md` Part 1)
# ─────────────────────────────────────────────────────────────────────────────

# Your Atlas connection string. Keep the quotes.
# Replace <username> and <password> with your database user's credentials.
# If your password contains @ : / ? # [ ] you MUST percent-encode it
# (@ becomes %40, # becomes %23, and so on).
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# The database inside the cluster. Leave this alone — it is the same database
# your teammate's Module 3 backend already writes to, which is what keeps live
# attrition updates visible to both apps.
MONGO_DB_NAME=IBM_HR_Analytics

# GridFS bucket that stores uploaded CV files. Leave as-is.
GRIDFS_BUCKET=cvs


# ─────────────────────────────────────────────────────────────────────────────
#  3. CLERK AUTHENTICATION  (required — see `what to do.md` Part 2)
# ─────────────────────────────────────────────────────────────────────────────

# From Clerk dashboard → API Keys. The pk_ one is safe in the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx



# The sk_ one is SECRET — server-side only, never commit it.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_CLERK_SECRET_KEY


# Comma-separated emails that are granted `admin` automatically the first time
# they sign in. This is how the very first admin account exists. After that you
# can promote people from the People & Roles screen in the UI.
ADMIN_EMAILS=you@example.com


# ─────────────────────────────────────────────────────────────────────────────
#  4. SERVER SETTINGS  (optional — sensible defaults already applied)
# ─────────────────────────────────────────────────────────────────────────────

# Port for the TalentPulse data API. Must match the vite proxy target.
PORT=5050

# How long an applicant must wait before re-applying to the SAME job post.
REAPPLY_COOLDOWN_HOURS=24

# How many high-risk employees appear in the admin's notification list.
ATTRITION_NOTIFY_TOP_N=5

# Minimum attrition probability (0-1) before an employee raises an alert.
ATTRITION_NOTIFY_THRESHOLD=0.5

# Largest CV upload accepted, in bytes (default 15 MB).
MAX_CV_BYTES=15728640

# How long to wait on a HuggingFace Space before giving up, in milliseconds.
# Cold Spaces can take 60s+ on the first request.
ML_TIMEOUT_MS=120000

# Extra browser origins allowed to call the API (comma-separated). localhost is
# already allowed. Add your Vercel URL here after deploying.
# CORS_ORIGINS=https://your-app.vercel.app

# OFFLINE DEMO ONLY. Setting this to true SKIPS Clerk token verification and
# trusts an `x-demo-email` header — anyone could impersonate anyone. Never set
# this on a deployed instance.
# AUTH_DISABLED=false
