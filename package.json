{
  "name": "mock-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "npm run db:sync && npm run db:seed",
    "db:sync": "node server/scripts/sync.js",
    "db:seed": "node server/scripts/seed.js",
    "db:reseed": "node server/scripts/seed.js --force",
    "db:precompute": "node server/scripts/precompute.js",
    "db:make-admin": "node server/scripts/makeAdmin.js",
    "db:status": "node server/scripts/status.js"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.51.0",
    "@clerk/express": "^1.7.30",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.511.0",
    "mongoose": "^8.20.1",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "vite": "^7.1.0"
  }
}
